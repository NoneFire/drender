{
  "name": "@drender/dsh-drender-plugin",
  "version": "0.1.0",
  "description": "DeepSeek Harness tools and Skill for validating and rendering md-report documents.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b && tsc -p tsconfig.client.json && node build-client.mjs && node ../../../scripts/package-dsh-skill.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.0-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@mdreport/data-sources": "workspace:^",
    "@mdreport/renderer-core": "workspace:^"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoneFire/drender.git",
    "directory": "plugins/hosts/dsh"
  },
  "homepage": "https://github.com/NoneFire/drender",
  "bugs": {
    "url": "https://github.com/NoneFire/drender/issues"
  },
  "author": {
    "name": "NoneFire"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "plugin",
    "report",
    "markdown",
    "md-report"
  ]
}
